<div class="flex items-center justify-between mb-6">
  <h1 class="type-serif-heading" style="font-size: var(--text-3xl);">Bulk edit phones</h1>
  <%= link_to "← Back to Invites", admin_invites_path, class: "btn btn-ghost btn-sm" %>
</div>

<p class="text-muted" style="font-size: var(--text-sm); margin-bottom: var(--space-4);">
  Add or fix phone numbers for many invites at once. Any format works — digits are
  extracted automatically. Use the filters to narrow the list (e.g. a side + "Not yet sent").
</p>

<%= render "admin/side_filter" %>

<div style="display: flex; gap: var(--space-2); align-items: center; flex-wrap: wrap; margin-bottom: var(--space-4);">
  <span class="text-muted">Sent:</span>
  <%= link_to "All",          bulk_phones_admin_invites_path(q: params[:q]),                    class: "btn btn-sm #{params[:filter].blank?      ? 'btn-highlight' : 'btn-outline'}" %>
  <%= link_to "Not yet sent", bulk_phones_admin_invites_path(q: params[:q], filter: "unsent"),  class: "btn btn-sm #{params[:filter] == 'unsent' ? 'btn-highlight' : 'btn-outline'}" %>
  <%= link_to "Sent",         bulk_phones_admin_invites_path(q: params[:q], filter: "sent"),    class: "btn btn-sm #{params[:filter] == 'sent'   ? 'btn-highlight' : 'btn-outline'}" %>
</div>

<%= form_with url: update_phones_admin_invites_path, method: :post do %>
  <%= hidden_field_tag :filter, params[:filter] if params[:filter].present? %>
  <%= hidden_field_tag :q, params[:q] if params[:q].present? %>

  <div style="margin-bottom: var(--space-4);">
    <%= submit_tag "Save phone numbers", class: "btn btn-primary btn-sm" %>
    <span class="text-muted" style="font-size: var(--text-sm); margin-left: var(--space-2);"><%= @invites.size %> invite(s) shown</span>
  </div>

  <div class="table-wrapper">
    <table>
      <thead>
        <tr>
          <th>Household</th>
          <th>Side</th>
          <th class="text-center">Party</th>
          <th>Sent</th>
          <th>Phone</th>
        </tr>
      </thead>
      <tbody>
        <% @invites.each do |invite| %>
          <tr>
            <td><%= link_to invite.name, admin_invite_path(invite) %></td>
            <td><span style="font-size: var(--text-xs); color: var(--color-text-muted);"><%= invite.side.titleize %></span></td>
            <td class="text-center text-muted"><%= invite.party_size %></td>
            <td>
              <% if invite.invite_sent_at %>
                <span class="text-success">✓</span>
              <% else %>
                <span class="text-muted">—</span>
              <% end %>
            </td>
            <td>
              <%= text_field_tag "invites[#{invite.id}][phone]", invite.phone, class: "form-input", style: "min-width: 12rem;", placeholder: "e.g. 559-819-1885" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div style="margin-top: var(--space-4);">
    <%= submit_tag "Save phone numbers", class: "btn btn-primary btn-sm" %>
  </div>
<% end %>
