<%= form_with model: [:admin, invite], class: "max-w-lg space-y-4" do |f| %>
  <% if invite.errors.any? %>
    <div class="notice-error">
      <% invite.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :name, "Household name", class: "form-label" %>
    <%= f.text_field :name, class: "form-input" %>
  </div>

  <div class="form-group">
    <%= f.label :email, "Email (optional)", class: "form-label" %>
    <%= f.email_field :email, class: "form-input", placeholder: "Leave blank if sending the link personally" %>
  </div>

  <div class="form-group">
    <%= f.label :phone, "Phone (optional)", class: "form-label" %>
    <%= f.text_field :phone, class: "form-input", placeholder: "Any format — digits are extracted automatically" %>
    <p class="text-muted" style="font-size: var(--text-xs); margin-top: 4px;">Used for RSVP phone lookup and the WhatsApp send.</p>
  </div>

  <div class="form-group">
    <%= f.label :side, "Side", class: "form-label" %>
    <%= f.select :side, Invite.sides.keys.map { |s| [ s.titleize, s ] }, {}, class: "form-input", style: "max-width: 12rem;" %>
    <p class="text-muted" style="font-size: var(--text-xs); margin-top: 4px;">Whose guest this is. Used for filtering and the events page.</p>
  </div>

  <div class="form-group">
    <%= f.label :party_size, "Invited allocation (party size)", class: "form-label" %>
    <%= f.number_field :party_size, class: "form-input", min: 0, max: 30, style: "max-width: 8rem;" %>
    <p class="text-muted" style="font-size: var(--text-xs); margin-top: 4px;">How many people this household is invited to bring. 0 = decided not to attend.</p>
  </div>

  <div class="form-group">
    <%= f.label :notes, "Notes (internal)", class: "form-label" %>
    <%= f.text_area :notes, class: "form-input", rows: 3 %>
  </div>

  <h3 class="type-serif-heading" style="font-size: var(--text-lg); margin-top: var(--space-6);">Guests</h3>
  <p class="text-muted" style="font-size: var(--text-sm); margin-bottom: var(--space-3);">
    Edit names and roles. Leave the bottom row blank if you're not adding anyone.
  </p>

  <%= f.fields_for :guests do |g| %>
    <div class="card" style="padding: var(--space-3); margin-bottom: var(--space-3);">
      <%= g.hidden_field :id %>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" style="margin-bottom: var(--space-2);">
        <div>
          <%= g.label :first_name, class: "form-label" %>
          <%= g.text_field :first_name, class: "form-input" %>
        </div>
        <div>
          <%= g.label :last_name, class: "form-label" %>
          <%= g.text_field :last_name, class: "form-input" %>
        </div>
      </div>
      <div style="margin-bottom: var(--space-2);">
        <%= g.label :phone, "Phone (optional)", class: "form-label" %>
        <%= g.text_field :phone, class: "form-input", placeholder: "Any format — digits extracted automatically" %>
      </div>
      <div style="display: flex; gap: var(--space-4); flex-wrap: wrap; align-items: center; font-size: var(--text-sm);">
        <label class="form-check"><%= g.check_box :is_primary %> <span class="form-check-label">Primary contact</span></label>
        <label class="form-check"><%= g.check_box :is_child %> <span class="form-check-label">Child</span></label>
        <% unless g.object.new_record? %>
          <label class="form-check" style="color: var(--color-error);"><%= g.check_box :_destroy %> <span class="form-check-label">Remove</span></label>
        <% end %>
      </div>
    </div>
  <% end %>

  <h3 class="type-serif-heading" style="font-size: var(--text-lg); margin-top: var(--space-6);">Invited Events</h3>
  <p class="text-muted" style="font-size: var(--text-sm); margin-bottom: var(--space-3);">
    Check the events this household is invited to. New households default to the shared
    events; side-specific events (e.g. Maiyaan/Haldi) are opt-in.
  </p>

  <%# Hidden field guarantees the event_ids key is always submitted, so unchecking
      every box correctly clears the assignment instead of leaving it unchanged. %>
  <%= hidden_field_tag "event_ids[]", "" %>

  <% selected_ids = params[:event_ids]&.map(&:to_i) %>
  <div class="card" style="padding: var(--space-3); margin-bottom: var(--space-3);">
    <% Event.order(:sort_order, :date).each do |event| %>
      <% checked = if selected_ids
                     selected_ids.include?(event.id)
                   elsif invite.persisted?
                     invite.events.include?(event)
                   else
                     event.default_invited?
                   end %>
      <label class="form-check" style="display: flex; align-items: center; gap: var(--space-2); padding: 2px 0;">
        <%= check_box_tag "event_ids[]", event.id, checked, id: "event_ids_#{event.id}" %>
        <span class="form-check-label">
          <%= event.name %>
          <% if event.date %><span class="text-muted" style="font-size: var(--text-xs);">· <%= event.date.strftime("%b %-d") %></span><% end %>
          <% unless event.default_invited? %><span class="text-muted" style="font-size: var(--text-xs);">(opt-in)</span><% end %>
        </span>
      </label>
    <% end %>
  </div>

  <div style="margin-top: var(--space-6);">
    <%= f.submit class: "btn btn-primary btn-sm" %>
    <%= link_to "Cancel", admin_invites_path, class: "btn btn-ghost btn-sm" %>
  </div>
<% end %>
