<div class="flex items-center justify-between mb-6">
  <h1 class="type-serif-heading" style="font-size: var(--text-3xl);"><%= @invite.name %></h1>
  <div class="flex gap-2">
    <%= link_to "Edit", edit_admin_invite_path(@invite), class: "btn btn-outline btn-sm" %>
    <%= button_to "Delete", admin_invite_path(@invite), method: :delete,
      data: { turbo_confirm: "Are you sure?" },
      class: "btn btn-danger btn-sm" %>
  </div>
</div>

<div class="grid grid-cols-2 gap-4 mb-6" style="font-size: var(--text-sm);">
  <div><span class="text-muted">Side:</span> <%= @invite.side.titleize %></div>
  <div><span class="text-muted">Party size:</span> <%= @invite.party_size.presence || "—" %></div>
  <div><span class="text-muted">Phone:</span> <%= @invite.phone.presence || "—" %></div>
  <div><span class="text-muted">Email:</span> <%= @invite.no_email? ? "None (send link personally)" : @invite.email %></div>
  <div><span class="text-muted">Responded:</span> <%= @invite.responded? ? @invite.responded_at.strftime("%b %d, %Y %l:%M %p") : "Not yet" %></div>
  <div><span class="text-muted">Attending:</span> <%= @invite.attending.nil? ? "Pending" : @invite.attending? ? "Yes" : "No" %></div>
  <div><span class="text-muted">Children Attending:</span> <%= @invite.children_attending? ? "Yes" : "No" %></div>
</div>

<% rsvp_link = rsvp_manage_url(token: Rails.application.message_verifier(:rsvp_management).generate(@invite.id, expires_in: 30.days)) %>
<div class="card mb-6" style="background: var(--color-bg-tertiary);">
  <h2 class="card-title">Personal RSVP Link</h2>
  <div class="card-body">
    <p style="font-size: var(--text-sm); color: var(--color-text-muted); margin-bottom: var(--space-2);">
      Send this link directly to the guest. It bypasses the email lookup.
    </p>
    <div style="display: flex; gap: var(--space-2); align-items: center; flex-wrap: wrap;">
      <input type="text" value="<%= rsvp_link %>" readonly
        style="flex: 1; font-size: var(--text-xs); font-family: monospace; padding: var(--space-2); border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-bg-secondary);"
        onclick="this.select();" />
      <button onclick="navigator.clipboard.writeText('<%= rsvp_link %>'); this.textContent='Copied!';"
        class="btn btn-outline btn-sm">Copy</button>
    </div>
  </div>
</div>

<% if @invite.notes.present? %>
  <div class="card mb-6" style="background: var(--color-bg-tertiary);">
    <h2 class="card-title">Notes from Guest</h2>
    <div class="card-body"><%= simple_format(@invite.notes) %></div>
  </div>
<% end %>

<h2 class="type-serif-heading" style="font-size: var(--text-lg); margin-bottom: var(--space-3);">Guests</h2>
<div class="table-wrapper mb-6">
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Meal</th>
        <th>Dietary Notes</th>
        <th>Primary</th>
        <th>Child</th>
        <th>Childcare</th>
      </tr>
    </thead>
    <tbody>
      <% @guests.each do |guest| %>
        <tr>
          <td><%= link_to guest.full_name, admin_guest_path(guest) %></td>
          <td><%= guest.meal_choice.titleize %></td>
          <td class="text-muted"><%= guest.dietary_notes.presence || "None" %></td>
          <td><%= guest.is_primary? ? "Yes" : "" %></td>
          <td><%= guest.is_child? ? "Yes" : "" %></td>
          <td><%= guest.needs_childcare? ? "Yes" : "" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<h2 class="type-serif-heading" style="font-size: var(--text-lg); margin-bottom: var(--space-3);">
  RSVP by event
  <span class="text-muted" style="font-size: var(--text-sm); font-weight: 400;">· ✓ attending · ✗ declined · — no answer</span>
</h2>
<% if @events.empty? %>
  <p class="text-muted" style="font-size: var(--text-sm);">This household isn't assigned to any events. Use <%= link_to "Edit", edit_admin_invite_path(@invite), style: "color: var(--color-accent);" %> to assign events.</p>
<% else %>
  <div class="table-wrapper">
    <table>
      <thead>
        <tr>
          <th>Guest</th>
          <% @events.each do |event| %>
            <th class="text-center"><%= link_to event.name, admin_event_path(event), style: "color: inherit;" %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% @guests.each do |guest| %>
          <tr>
            <td><%= guest.full_name %><% if guest.is_primary? %> <span class="text-muted" style="font-size: var(--text-xs);">(primary)</span><% end %></td>
            <% @events.each do |event| %>
              <% rsvp = @rsvp_for[[ guest.id, event.id ]] %>
              <td class="text-center">
                <% if rsvp&.attending == true %><span class="text-success">✓</span>
                <% elsif rsvp&.attending == false %><span class="text-error">✗</span>
                <% else %><span class="text-muted">—</span><% end %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<h2 class="type-serif-heading" style="font-size: var(--text-lg); margin-top: var(--space-8); margin-bottom: var(--space-3);">Household tools</h2>

<details class="card" style="margin-bottom: var(--space-3);">
  <summary style="cursor: pointer; padding: var(--space-3) var(--space-4); font-weight: 600;">Merge another household into this one</summary>
  <div class="card-body">
    <p class="text-muted" style="font-size: var(--text-sm); margin-bottom: var(--space-3);">
      Moves the selected household's guests and events into <strong><%= @invite.name %></strong> (party sizes add up), then deletes it. This can't be undone.
    </p>
    <%= form_with url: merge_admin_invite_path(@invite), method: :post, class: "flex gap-2", style: "flex-wrap: wrap; align-items: center;" do %>
      <select name="source_id" class="form-input" required style="min-width: 20rem;">
        <option value="">Select a household to merge in…</option>
        <% @merge_candidates.each do |other| %>
          <option value="<%= other.id %>"><%= other.name %> — <%= other.side.titleize %>, <%= @guest_counts[other.id] || 0 %> guest(s)</option>
        <% end %>
      </select>
      <%= submit_tag "Merge in", class: "btn btn-primary btn-sm", data: { turbo_confirm: "Merge the selected household into #{@invite.name}? The other household will be deleted." } %>
    <% end %>
  </div>
</details>

<details class="card" style="margin-bottom: var(--space-3);">
  <summary style="cursor: pointer; padding: var(--space-3) var(--space-4); font-weight: 600;">Split guests into a new household</summary>
  <div class="card-body">
    <p class="text-muted" style="font-size: var(--text-sm); margin-bottom: var(--space-3);">
      Move the selected guests into a brand-new household (inherits this household's side and events). Leave at least one guest here.
    </p>
    <%= form_with url: split_admin_invite_path(@invite), method: :post do %>
      <div style="margin-bottom: var(--space-3);">
        <% @guests.each do |guest| %>
          <label class="form-check" style="display: block; margin-bottom: 4px;">
            <%= check_box_tag "guest_ids[]", guest.id, false %>
            <span class="form-check-label"><%= guest.full_name %><% if guest.is_primary? %> <span class="text-muted" style="font-size: var(--text-xs);">(primary)</span><% end %></span>
          </label>
        <% end %>
      </div>
      <div class="flex gap-2" style="flex-wrap: wrap; align-items: center;">
        <%= text_field_tag "new_name", nil, class: "form-input", placeholder: "New household name", required: true, style: "min-width: 16rem;" %>
        <%= submit_tag "Split off", class: "btn btn-primary btn-sm", data: { turbo_confirm: "Create a new household with the selected guests?" } %>
      </div>
    <% end %>
  </div>
</details>
