<div class="flex items-center justify-between mb-6">
  <h1 class="type-serif-heading" style="font-size: var(--text-3xl);">Invites</h1>
  <div class="flex gap-2">
    <%= link_to "Export RSVP Links", admin_export_links_path, class: "btn btn-outline btn-sm" %>
    <%= link_to "New Invite", new_admin_invite_path, class: "btn btn-primary btn-sm" %>
  </div>
</div>

<div class="card mb-4" style="background: var(--color-bg-tertiary); padding: var(--space-3); display: flex; gap: var(--space-3); flex-wrap: wrap; align-items: center;">
  <strong>Invitations sent: <%= @sent_count %> / <%= @total_count %></strong>
  <span class="text-muted" style="margin-left: var(--space-2);">Filter:</span>
  <%= link_to "All",          admin_invites_path(q: params[:q]),                   class: "btn btn-sm #{params[:filter].blank?      ? 'btn-highlight' : 'btn-outline'}" %>
  <%= link_to "Not yet sent", admin_invites_path(q: params[:q], filter: "unsent"), class: "btn btn-sm #{params[:filter] == 'unsent' ? 'btn-highlight' : 'btn-outline'}" %>
  <%= link_to "Sent",         admin_invites_path(q: params[:q], filter: "sent"),   class: "btn btn-sm #{params[:filter] == 'sent'   ? 'btn-highlight' : 'btn-outline'}" %>
</div>

<%= form_with url: admin_invites_path, method: :get, class: "mb-4" do %>
  <%= hidden_field_tag :filter, params[:filter] if params[:filter].present? %>
  <div class="flex gap-2">
    <%= text_field_tag :q, params[:q], placeholder: "Search by name or email...", class: "form-input flex-1" %>
    <%= submit_tag "Search", class: "btn btn-outline btn-sm" %>
  </div>
<% end %>

<div class="table-wrapper">
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Email</th>
        <th class="text-center">Guests</th>
        <th>Sent</th>
        <th>Responded</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @invites.each do |invite| %>
        <tr>
          <td><%= link_to invite.name, admin_invite_path(invite) %></td>
          <td class="text-muted"><%= invite.no_email? ? "—" : invite.email %></td>
          <td class="text-center"><%= invite.guests.size %></td>
          <td>
            <% if invite.invite_sent_at %>
              <span class="text-success">✓ <%= invite.invite_sent_at.strftime("%b %-d") %></span>
            <% else %>
              <span class="text-muted">—</span>
            <% end %>
          </td>
          <td>
            <% if invite.responded? %>
              <span class="text-success">Yes</span>
            <% else %>
              <span class="text-muted">No</span>
            <% end %>
          </td>
          <td class="text-right">
            <% if invite.invite_sent_at %>
              <%= button_to "Mark unsent", unmark_sent_admin_invite_path(invite), method: :post, class: "btn btn-outline btn-sm", form: { style: "display: inline;" }, data: { turbo_confirm: "Clear the sent date for #{invite.name}?" } %>
            <% else %>
              <%= button_to "Mark sent",   mark_sent_admin_invite_path(invite),   method: :post, class: "btn btn-outline btn-sm", form: { style: "display: inline;" } %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
