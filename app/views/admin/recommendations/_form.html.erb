<%= form_with model: [:admin, recommendation], class: "max-w-lg space-y-4" do |f| %>
  <% if recommendation.errors.any? %>
    <div class="notice-error">
      <% recommendation.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :name, "Place name", class: "form-label" %>
    <%= f.text_field :name, class: "form-input", placeholder: "e.g. Balboa Island" %>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div class="form-group">
      <%= f.label :category, "Category (optional)", class: "form-label" %>
      <%= f.text_field :category, class: "form-input", placeholder: "e.g. Food · Beach · Shopping" %>
    </div>
    <div class="form-group">
      <%= f.label :location, "Location line (optional)", class: "form-label" %>
      <%= f.text_field :location, class: "form-input", placeholder: "e.g. ~30 min · Newport Beach" %>
    </div>
  </div>

  <div class="form-group">
    <%= f.label :note, "Nuvdeep's note", class: "form-label" %>
    <%= f.text_area :note, rows: 4, class: "form-input", placeholder: "Why you love it / what to do there…" %>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div class="form-group">
      <%= f.label :url, "Link (optional)", class: "form-label" %>
      <%= f.url_field :url, class: "form-input", placeholder: "https://… (website or map)" %>
    </div>
    <div class="form-group">
      <%= f.label :sort_order, "Sort order", class: "form-label" %>
      <%= f.number_field :sort_order, class: "form-input", style: "max-width: 8rem;" %>
      <p class="text-muted" style="font-size: var(--text-xs); margin-top: 4px;">Lower shows first.</p>
    </div>
  </div>

  <div class="form-group">
    <label class="form-check" style="display: flex; align-items: center; gap: var(--space-2);">
      <%= f.check_box :published %>
      <span class="form-check-label">Published (visible on the Explore page)</span>
    </label>
  </div>

  <div style="margin-top: var(--space-6);">
    <%= f.submit class: "btn btn-primary btn-sm" %>
    <%= link_to "Cancel", admin_recommendations_path, class: "btn btn-ghost btn-sm" %>
  </div>
<% end %>
